#!/usr/bin/env bash
# DOTFILES_CODEX_WRAPPER=1
# CODEX_HOME은 별도 지정이 없으면 Codex의 사용자 기본 경로를 사용한다.
export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"

wrapper_path="$0"
case "$wrapper_path" in
  /*) ;;
  *) wrapper_path="$(command -v "$wrapper_path" 2>/dev/null || printf '%s' "$wrapper_path")" ;;
esac
wrapper_path="$(cd "$(dirname "$wrapper_path")" 2>/dev/null && pwd -P)/$(basename "$wrapper_path")"

if [ -n "${CODEX_REAL_BIN:-}" ] && [ -x "$CODEX_REAL_BIN" ] && [ ! "$CODEX_REAL_BIN" -ef "$wrapper_path" ]; then
  exec "$CODEX_REAL_BIN" "$@"
fi

IFS=: read -r -a path_dirs <<< "${PATH:-}"
for path_dir in "${path_dirs[@]}"; do
  [ -n "$path_dir" ] && [ "$path_dir" != "." ] || continue
  candidate="$path_dir/codex"
  if [ -x "$candidate" ] && [ ! "$candidate" -ef "$wrapper_path" ]; then
    exec "$candidate" "$@"
  fi
done

printf '[codex wrapper] Codex CLI를 찾지 못했어요. CODEX_REAL_BIN으로 실행 파일 경로를 지정하세요.\n' >&2
exit 127
